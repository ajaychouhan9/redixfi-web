{
  "name": "redixfi-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:compliance && npm run check:auth-fetch && npm run check:no-change-stock && npm run check:wording && next build",
    "start": "next start",
    "lint": "eslint",
    "check:compliance": "node scripts/check-compliance.mjs",
    "check:auth-fetch": "node scripts/check-auth-fetch.mjs",
    "check:no-change-stock": "node scripts/check-no-change-stock-button.mjs",
    "test:sitemap": "node scripts/test-sitemap.mjs && node scripts/test-sitemap-url-rules.mjs",
    "test:stock-clarity": "node scripts/test-stock-clarity.mjs",
    "check:sitemap-live": "node scripts/check-sitemap-live.mjs",
    "check:wording": "node scripts/test-wording.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
